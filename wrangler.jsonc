{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paddock-pocket",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "f1.xiaodinglab.com",
      "custom_domain": true
    },
    {
      "pattern": "xiaodinglab.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    { "name": "AUTH_IP_LIMITER", "namespace_id": "17001", "simple": { "limit": 30, "period": 60 } },
    { "name": "AUTH_EMAIL_LIMITER", "namespace_id": "17002", "simple": { "limit": 1, "period": 60 } }
  ]
}
