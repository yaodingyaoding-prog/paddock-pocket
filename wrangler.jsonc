{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paddock-pocket",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "xiaodinglab.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
