<view class="screen" style="{{skin}}"><view class="page"><view class="error" wx:if="{{error}}">{{error}}<button class="button secondary" bindtap="load">重试</button></view><block wx:if="{{item}}"><view class="eyebrow">{{item.topic}}</view><view class="hero-title">{{item.title}}</view><view class="muted">{{item.source}} · {{item.date}}</view><view class="body">{{item.summary}}</view><view class="body" wx:for="{{paragraphs}}" wx:key="*this">{{item}}</view><view class="button-row"><button class="button secondary" bindtap="source">复制原文链接</button><button class="button" open-type="share">分享</button></view></block></view></view>
