<view class="screen" style="{{skin}}"><view class="page"><view class="eyebrow">DRIVER DOSSIER</view><view class="row"><image class="avatar" src="{{driver.avatar}}" mode="aspectFill" binderror="avatarError"/><view class="grow"><view class="subheading">{{driver.driverName||'车手档案'}}</view><view class="muted">{{driver.teamName}} {{driver.number?'#'+driver.number:''}}</view></view><button class="heart {{followed?'active':''}}" bindtap="follow" disabled="{{account.saving}}">{{followed?'♥':'♡'}}</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{archive}}"><view class="card"><view class="name">{{archive.country}}</view><view class="muted">生日 {{archive.birthday||'资料待补充'}}</view></view><view class="career-grid"><view wx:for="{{stats}}" wx:key="label"><view class="metric">{{item.value}}</view><view class="label">{{item.label}}</view></view></view><view class="section"><view class="subheading">赛季履历</view><view class="row" wx:for="{{archive.history}}" wx:key="key"><view class="name">{{item.year}}</view><view class="grow"><view>{{item.team}}</view><view class="label">{{item.number?'#'+item.number:''}}</view></view><view>{{item.points}} 分</view></view></view></view><button open-type="share" class="button secondary">分享档案</button></view></view>
