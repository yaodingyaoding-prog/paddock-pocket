<view class="screen" style="{{skin}}"><view class="page"><view class="eyebrow">INSIDE THE PADDOCK</view><view class="heading">探索</view><view class="card hero" bindtap="replays"><view class="badge">RACE REPLAYS</view><view class="hero-title">重返每一个比赛周末</view><view class="muted">按赛季、分站与场次查找回放</view><button class="button secondary small" catchtap="replays">赛事回放</button></view><view class="section"><view class="subheading">观赛入口</view><view class="muted">复制入口后，在浏览器打开。</view><view class="button-row"><button class="button secondary" data-kind="smg" bindtap="watch">五星体育</button><button class="button secondary" data-kind="tencent" bindtap="watch">腾讯视频</button></view></view><view class="toolbar"><view class="subheading">围场新闻</view><button class="button secondary small" loading="{{busy}}" disabled="{{busy}}" bindtap="refresh">刷新</button></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="article"><view class="badge">{{item.topic}}</view><view class="news-title">{{item.title}}</view><view class="muted">{{item.summary}}</view><view class="label">{{item.source}} · {{item.date}}</view></view><view class="status">{{stamp}}</view></view></view>
