<view class="screen" style="{{skin}}"><view class="page">
 <view class="eyebrow">RACE WEEKEND</view><view class="toolbar"><view class="heading">赛程</view><picker range="{{seasons}}" range-key="year" value="{{seasonIndex}}" bindchange="changeSeason"><view class="select">{{seasons[seasonIndex].year}} 赛季</view></picker></view>
 <view class="chips"><button class="chip {{calendar?'':'selected'}}" bindtap="showWeekend">比赛周末</button><button class="chip {{calendar?'selected':''}}" bindtap="showCalendar">完整赛历 · {{races.length}}</button></view>
 <view class="error" wx:if="{{error}}">{{error}}<button class="button small secondary" bindtap="refresh">重试</button></view><view class="loading" wx:if="{{busy}}">正在更新比赛周末…</view>
 <view wx:if="{{calendar}}"><view class="calendar-card" wx:for="{{races}}" wx:key="id" data-id="{{item.id}}" bindtap="selectRace"><view class="badge">ROUND {{item.round}}</view><view class="news-title">{{item.name}}</view><view class="muted">{{item.circuit.place}} · {{item.circuit.name}}</view></view></view>
 <block wx:elif="{{race}}"><view class="card hero"><view class="badge">ROUND {{race.round}}</view><view class="hero-title">{{race.name}}</view><view class="muted">{{race.circuit.name}} · {{race.circuit.place}}</view><image wx:if="{{track}}" class="track" src="{{track}}" mode="aspectFit"/><view class="hero-meta"><view><view class="metric">{{race.circuit.display.trackLength||'—'}}</view><view class="metric-label">单圈长度</view></view><view><view class="metric">{{race.circuit.display.laps||'—'}}</view><view class="metric-label">正赛圈数</view></view><view><view class="metric">{{race.circuit.totalCorners||'—'}}</view><view class="metric-label">弯道</view></view></view><view class="forecast"><view class="muted">距离下一场次</view><view class="list-title">{{countdown}}</view></view><button open-type="share" class="button secondary small">分享比赛周末</button></view>
 <view class="card"><view class="eyebrow">TRACKSIDE WEATHER</view><view class="subheading">赛道天气 · {{race.circuit.place}}</view><view wx:if="{{weather}}"><view class="muted">当地此刻 · {{weather.timezone}}</view><view class="weather-now"><view class="temperature">{{weather.temperature}}°</view><view><view class="name">{{weather.condition}}</view><view class="label">风速 {{weather.wind}} km/h</view></view></view><picker range="{{sessions}}" range-key="label" value="{{weatherIndex}}" bindchange="changeWeather"><view class="select">场次预报 · {{weather.forecastLabel}}</view></picker><view class="forecast">{{weather.forecast}}</view><view class="status">{{weather.stale?'最近保存的预报 · ':''}}{{weather.fetched}} · 赛道当地获取时间 · Open-Meteo · CC BY 4.0</view></view><view class="loading" wx:if="{{weatherLoading}}">正在获取赛道天气…</view><view class="error" wx:if="{{weatherError}}">{{weatherError}}</view><button class="button secondary small" bindtap="loadWeather">更新天气</button></view>
 <view class="section"><view class="eyebrow">THE WEEKEND</view><view class="subheading">赛事时间安排</view><view class="muted">{{preferences.timezone}}</view><view class="row session" wx:for="{{sessions}}" wx:key="id" data-id="{{item.id}}" bindtap="results"><view class="grow"><view class="name">{{item.label}}</view><view class="label">{{item.time}}</view></view><view class="badge">{{item.finished?'查看成绩':'场次详情'}}</view></view></view></block>
 <view class="status">{{stamp}}</view>
</view></view>
