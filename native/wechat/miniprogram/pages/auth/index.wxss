.auth-banner{overflow:hidden;position:relative;padding:40rpx 0 70rpx}.auth-banner .hero-title{position:relative;z-index:1;font-size:68rpx}.track-lines{position:absolute;right:-220rpx;top:20rpx;width:500rpx;height:360rpx;transform:rotate(-28deg);opacity:.45}.track-lines view{position:absolute;inset:15rpx;border:12rpx solid var(--accent);border-radius:45%;animation:racing-line 8s ease-in-out infinite}.track-lines view:nth-child(2){inset:50rpx;animation-delay:-2.6s;opacity:.6}.track-lines view:nth-child(3){inset:85rpx;animation-delay:-5.2s;opacity:.35}@keyframes racing-line{0%,100%{transform:translateX(0) rotate(-6deg);border-radius:45% 20% 45% 30%}50%{transform:translateX(-35rpx) rotate(12deg);border-radius:25% 45% 28% 48%}}.heart{font-size:25rpx;padding:28rpx 0}
