<view class="screen" style="{{skin}}"><view class="page"><view class="auth-banner"><view class="eyebrow">YOUR PLACE ON THE GRID</view><view class="hero-title">每一场，<view>都在围场。</view></view><view class="track-lines"><view/><view/><view/></view></view><view class="chips"><button class="chip {{mode==='login'?'selected':''}}" data-mode="login" bindtap="mode" disabled="{{busy}}">登录</button><button class="chip {{mode==='register'?'selected':''}}" data-mode="register" bindtap="mode" disabled="{{busy}}">注册</button></view><view class="subheading">{{mode==='forgot'?'找回密码':mode==='register'?'创建车迷账号':'欢迎回到围场'}}</view><input wx:if="{{mode==='register'}}" class="input" placeholder="昵称" maxlength="30" value="{{name}}" data-field="name" bindinput="input" disabled="{{busy}}"/><input class="input" placeholder="邮箱" type="text" maxlength="254" value="{{email}}" data-field="email" bindinput="input" disabled="{{busy}}"/><input wx:if="{{mode!=='forgot'}}" class="input" placeholder="密码，至少 6 个字符" password="{{true}}" maxlength="128" value="{{password}}" data-field="password" bindinput="input" disabled="{{busy}}"/><view wx:if="{{mode==='forgot'}}" class="muted">邮件中的安全链接会带你前往本站完成密码重置。</view><view wx:else class="privacy"><checkbox-group bindchange="agree"><label><checkbox value="yes" checked="{{agreed}}" disabled="{{busy}}" color="#29dec0"/>我已阅读并同意</label></checkbox-group><text class="link" bindtap="privacy">隐私说明</text></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="status">{{message}}</view><button class="button" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{mode==='forgot'?'发送重置邮件':mode==='register'?'创建账号':'登录'}}</button><button wx:if="{{mode==='login'}}" class="heart" data-mode="forgot" bindtap="mode" disabled="{{busy}}">忘记密码</button></view></view>
