<view class="screen" style="{{skin}}"><view class="page"><view class="eyebrow">RACE REPLAYS</view><view class="heading">赛事回放</view><view class="chips"><picker range="{{seasons}}" range-key="year" value="{{seasonIndex}}" bindchange="changeSeason"><view class="select">{{seasons[seasonIndex].year}} 赛季</view></picker><picker range="{{types}}" range-key="label" value="{{type}}" bindchange="changeType"><view class="select">{{types[type].label}}</view></picker></view><input class="input" placeholder="搜索分站、赛道或轮次" value="{{search}}" bindinput="search"/><view class="muted">复制 Bilibili 或腾讯视频搜索入口，在浏览器打开选择回放。</view><view class="error" wx:if="{{error}}">{{error}}<button class="button secondary" bindtap="refresh">重试</button></view><view class="loading" wx:if="{{busy}}">正在读取赛历…</view><view class="card" wx:for="{{races}}" wx:key="id"><view class="badge">ROUND {{item.round}}</view><view class="news-title">{{item.name}}</view><view class="label">{{item.circuit.name}}</view><view class="button-row"><button class="button secondary small" data-id="{{item.id}}" data-platform="bilibili" bindtap="copy">Bilibili</button><button class="button secondary small" data-id="{{item.id}}" data-platform="tencent" bindtap="copy">腾讯视频</button></view></view><view wx:if="{{!busy&&!races.length}}" class="empty">没有符合条件的比赛</view></view></view>
