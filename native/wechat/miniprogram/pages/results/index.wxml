<view class="screen" style="{{skin}}"><view class="page"><view class="eyebrow">THE SESSION</view><view class="heading">{{title}}</view><view wx:if="{{busy}}" class="loading">正在读取成绩…</view><view wx:if="{{error}}" class="error">{{error}}<button class="button secondary" bindtap="refresh">重试</button></view><view wx:if="{{pending}}" class="empty">比赛尚未开始，成绩将在结束后公布。</view><view class="row" wx:for="{{rows}}" wx:key="name"><view class="rank">{{item.position}}</view><view class="grow"><view class="name">{{item.name}}</view><view class="label">{{item.team}}</view></view><view class="name">{{item.result}}</view></view><view wx:if="{{!pending&&!busy&&!error&&!rows.length}}" class="empty">暂时没有这场比赛的成绩。</view></view></view>
