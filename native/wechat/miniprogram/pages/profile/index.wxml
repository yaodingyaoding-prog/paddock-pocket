<view class="screen" style="{{skin}}"><view class="page"><view class="eyebrow">MY PADDOCK</view><view class="heading">我的</view><view wx:if="{{account.accountState==='loading'}}" class="loading">正在连接账号…</view><view wx:elif="{{account.accountState==='unavailable'}}" class="card"><view class="body">账号服务暂时无法连接</view><view class="error" wx:if="{{account.error}}">{{account.error}}</view><button class="button" bindtap="retry">重新连接</button></view><view wx:elif="{{!account.user}}" class="card hero"><view class="hero-title">你的车迷通行证</view><view class="muted">登录后，让阵容、主题和时区随账号同步。</view><view class="button-row"><button class="button" bindtap="login">登录 / 注册</button></view></view><block wx:else><view class="license"><view class="badge">PADDOCK POCKET · FAN LICENCE</view><view class="row"><image class="avatar" src="{{avatar||'/assets/nav/profile-on.png'}}" mode="aspectFill" binderror="avatarError"/><view class="grow"><view class="license-name">{{account.user.name}}</view><view class="member">{{member}}</view></view></view><view class="muted">{{account.saving?'正在保存到云端…':account.preferencesReady?'账号设置已同步':'正在读取云端设置…'}}</view></view><view class="error" wx:if="{{account.error}}">{{account.error}}<button class="button secondary small" bindtap="retry">重试同步</button></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="section"><view class="toolbar"><view class="subheading">我的领奖台</view><button class="button secondary small" bindtap="rankings">选择车手</button></view><view class="podium"><view class="podium-slot" wx:for="{{podium}}" wx:key="slot" data-id="{{item.driverId}}" bindtap="driver"><view class="podium-name">{{item.driverName}}</view><image class="podium-photo" src="{{item.avatar}}" webp="{{true}}" mode="aspectFit"/><view class="podium-base {{item.className}}">{{item.slot}}</view></view></view><view class="chips" wx:if="{{teams.length}}"><button class="chip selected" wx:for="{{teams}}" wx:key="id" data-id="{{item.id}}" bindtap="removeTeam" disabled="{{account.saving}}">{{item.name}} ×</button></view></view><view class="section"><view class="subheading">界面主题</view><view class="themes"><button wx:for="{{themes}}" wx:key="id" class="theme {{preferences.theme===item.id?'selected':''}}" style="background:{{item.panel}};color:{{item.text}}" data-field="theme" data-id="{{item.id}}" bindtap="setting" disabled="{{account.saving||!account.preferencesReady}}">{{item.label}}</button></view><view class="subheading">点缀色</view><view class="themes"><button wx:for="{{accents}}" wx:key="id" class="swatch" style="background:{{item.color}}" data-field="accent" data-id="{{item.id}}" bindtap="setting" disabled="{{account.saving||!account.preferencesReady}}" aria-label="{{item.label}}">{{preferences.accent===item.id?'✓':''}}</button></view></view><view class="section"><view class="subheading">时间显示</view><view class="muted">当前时区 · {{preferences.timezone}}</view><input class="input" value="{{zoneSearch}}" placeholder="搜索城市或时区，如 Shanghai、London" bindinput="searchZone"/><picker range="{{zones}}" value="{{zoneIndex}}" bindchange="timezone" disabled="{{account.saving||!account.preferencesReady||!zones.length}}"><view class="select">{{zones.length?zones[zoneIndex]:'没有匹配的时区'}}</view></picker></view><button class="button secondary" bindtap="logout" loading="{{loggingOut}}" disabled="{{loggingOut}}">退出登录</button></block><view class="button-row"><button class="button secondary small" bindtap="privacy">隐私说明</button><button class="button secondary small" bindtap="github">GitHub · Star</button></view><view class="status">围场口袋 · 微信小程序 0.1.0</view></view></view>
