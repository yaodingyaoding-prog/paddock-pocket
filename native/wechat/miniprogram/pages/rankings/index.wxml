<view class="screen" style="{{skin}}"><view class="page"><view class="eyebrow">THE CHAMPIONSHIP</view><view class="toolbar"><view class="heading">积分榜</view><picker range="{{seasons}}" range-key="year" value="{{seasonIndex}}" bindchange="changeSeason"><view class="select">{{seasons[seasonIndex].year}} 赛季</view></picker></view>
<view class="chips"><button class="chip {{kind==='drivers'?'selected':''}}" data-kind="drivers" bindtap="switchKind">车手积分</button><button class="chip {{kind==='teams'?'selected':''}}" data-kind="teams" bindtap="switchKind">车队积分</button></view><view class="error" wx:if="{{error}}">{{error}}</view><view class="loading" wx:if="{{busy}}">正在更新积分…</view>
<view class="row" wx:for="{{rows}}" wx:key="key"><view class="rank">{{item.position}}</view><image wx:if="{{kind==='drivers'}}" class="avatar" src="{{item.avatar}}" data-index="{{index}}" binderror="avatarError" mode="aspectFill"/><image wx:elif="{{item.car}}" class="car" src="{{item.car}}" mode="aspectFit"/><view class="grow" data-index="{{index}}" bindtap="detail"><view class="name">{{item.name}}</view><view class="label">{{item.team}} {{kind==='drivers'?'#'+item.number:''}}</view></view><image class="open-icon" src="/assets/nav/detail-on.png" data-index="{{index}}" bindtap="detail"/><view class="points">{{item.points}}</view><button class="heart {{item.followed?'active':''}}" data-index="{{index}}" catchtap="follow" disabled="{{account.saving}}">{{item.followed?'♥':'♡'}}</button></view>
<button wx:if="{{total>5}}" class="button secondary small" bindtap="expand">{{expanded?'收起榜单':'展开完整榜单'}} · {{total}}</button><view wx:if="{{!busy&&!rows.length}}" class="empty">该赛季暂无积分数据</view><view class="status">{{stamp}}</view></view></view>
