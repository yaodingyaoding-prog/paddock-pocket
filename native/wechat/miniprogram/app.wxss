page{background:#0d1017;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button{font-size:26rpx;line-height:1.5;margin:0;border-radius:20rpx}button::after{border:0}button[disabled]{opacity:.5}.screen{min-height:100vh;box-sizing:border-box;background:var(--bg);color:var(--text);--bg:#0d1017;--panel:#171d28;--text:#f3f5fa;--muted:#9aa7bb;--accent:#29dec0}.page{padding:36rpx 32rpx 56rpx}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:var(--accent);font-weight:700;margin-bottom:14rpx}.heading{font-size:54rpx;line-height:1.2;font-weight:800;letter-spacing:-1rpx}.subheading{font-size:34rpx;font-weight:700;margin-bottom:22rpx}.muted{color:var(--muted);font-size:24rpx;line-height:1.7}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:34rpx}.card{background:var(--panel);padding:30rpx;margin:24rpx 0;border-radius:10rpx 36rpx 10rpx 10rpx;border:1rpx solid rgba(139,158,180,.22)}.hero{border-top:5rpx solid var(--accent);padding:36rpx 30rpx}.hero-title{font-size:52rpx;font-weight:800;line-height:1.25;margin:16rpx 0}.hero-meta{display:flex;justify-content:space-between;gap:18rpx;margin-top:28rpx}.metric{font-size:38rpx;font-weight:700}.metric-label{color:var(--muted);font-size:20rpx;margin-top:8rpx}.track{width:100%;height:300rpx;margin:24rpx 0}.chips{display:flex;gap:12rpx;flex-wrap:wrap;margin:24rpx 0}.chip{background:var(--panel);color:var(--muted);padding:15rpx 24rpx;border:1rpx solid rgba(139,158,180,.25);border-radius:40rpx;font-size:24rpx}.chip.selected{color:var(--accent);border-color:var(--accent)}.button{background:var(--accent);color:#09241d;padding:21rpx 28rpx;font-weight:650}.button.secondary{background:var(--panel);color:var(--text);border:1rpx solid rgba(139,158,180,.3)}.button.small{font-size:23rpx;padding:14rpx 20rpx}.button-row{display:flex;flex-wrap:wrap;gap:16rpx;margin:22rpx 0}.error{padding:20rpx 24rpx;margin:20rpx 0;border:1rpx solid #f6909e;color:#f6909e;font-size:24rpx;line-height:1.6;border-