y-content:space-between;gap:12rpx;margin:35rpx 0}.podium-slot{width:32%;text-align:center}.podium-name{font-size:22rpx;min-height:64rpx}.podium-photo{width:130rpx;height:150rpx;margin:12rpx auto 0}.podium-base{border-top:4rpx solid var(--accent);padding:16rpx;background:var(--panel);font-weight:800;font-size:42rpx}.podium-base.first{padding-bottom:60rpx}.podium-base.second{padding-bottom:35rpx}.themes{display:flex;gap:16rpx;flex-wrap:wrap;margin:20rpx 0}.theme{box-sizing:border-box;width:30%;padding:23rpx 10rpx;border:2rpx solid rgba(139,158,180,.3);border-radius:20rpx;text-align:center;font-size:22rpx}.theme.selected{border-color:var(--accent);color:var(--accent)}.swatch{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:50%;font-size:28rpx;color:#071b15}.privacy{display:flex;align-items:center;margin:26rpx 0;color:var(--muted);font-size:23rpx}.link{color:var(--accent);font-size:25rpx;margin:20rpx 0}.empty{padding:48rpx 16rpx;text-align:center;color:var(--muted);font-size:26rpx;line-height:1.8}.section{margin:40rpx 0}.career-grid{display:flex;flex-wrap:wrap;gap:16rpx}.career-grid>view{width:26%;padding:20rpx;background:var(--panel);border-radius:18rpx}.loading{font-size:25rpx;color:var(--accent);padding:20rpx 0}button:active{opacity:.75;transform:scale(.985)}
