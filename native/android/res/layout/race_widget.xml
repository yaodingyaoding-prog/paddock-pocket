<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="围场口袋" android:textColor="#2BE0C0" android:textSize="11sp"/><TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="28dp" android:gravity="right" android:text="刷新 ↻" android:textColor="#A5B5C5" android:textSize="11sp" android:contentDescription="刷新小组件数据"/></LinearLayout>
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下一场比赛" android:textColor="#F4F6FB" android:textSize="20sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_session" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#94A3B8" android:textSize="11sp" android:maxLines="1"/>
  <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#2BE0C0" android:textSize="26sp" android:format="剩余 %s" android:countDown="true" android:layout_marginTop="5dp"/>
  <TextView android:id="@+id/widget_weather" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D9E5F0" android:textSize="12sp" android:maxLines="2" android:layout_marginTop="5dp"/>
  <TextView android:id="@+id/widget_driver" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D9E5F0" android:textSize="12sp" android:maxLines="3"/>
  <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#94A3B8" android:textSize="9sp" android:maxLines="2" android:layout_marginTop="7dp"/>
</LinearLayout>

